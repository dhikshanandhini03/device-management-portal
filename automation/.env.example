# Copy to .env and adjust. Values below are DEVELOPMENT-ONLY demo credentials for the local simulated stack.
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
SUPPORT_USERNAME=support
SUPPORT_PASSWORD=Support@12345
READONLY_USERNAME=readonly
READONLY_PASSWORD=Readonly@12345

# Shared key the device simulator uses for the device gateway API (used to inject device events in tests).
GATEWAY_API_KEY=dev-gateway-key-change-me

DEFAULT_TIMEOUT_MS=15000
COMMAND_TIMEOUT_S=60
DEPLOYMENT_TIMEOUT_S=150
