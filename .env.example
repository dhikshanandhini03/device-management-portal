# Copy to .env to override docker-compose defaults. Development-only values - never reuse in production.
POSTGRES_DB=bellstb
POSTGRES_USER=bellstb
POSTGRES_PASSWORD=bellstb_dev_password

JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60
GATEWAY_API_KEY=dev-gateway-key-change-me

SEED_DEVICE_COUNT=500
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SUPPORT_PASSWORD=Support@12345
SEED_READONLY_PASSWORD=Readonly@12345

FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8010
DB_HOST_PORT=5433

SIM_AUTOSTART=true
SIM_TICK_SECONDS=5
SIM_COMMAND_STAGE_SECONDS=1.5
