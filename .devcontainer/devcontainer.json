{
  "name": "BELL STB Device Management Portal",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postStartCommand": "docker compose up -d --build --wait --wait-timeout 600",
  "forwardPorts": [3000, 8010],
  "portsAttributes": {
    "3000": { "label": "Portal UI", "onAutoForward": "openBrowser" },
    "8010": { "label": "Backend API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
